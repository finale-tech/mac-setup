{
    "description": "Canary (matrix) in Karabiner — macOS on U.S. QWERTY — Extend layer: IJKL arrows, symbol grid (openers E/D/C, closers R/F/V, ! & = _ * | and . on M), Space=Backspace, Enter=line-end-;, Extend+Cmd physical-position rescues",
    "manipulators": [
        {
            "description": "Caps Lock → Extend layer",
            "from": { "key_code": "caps_lock", "modifiers": { "optional": ["any"] } },
            "to": [{ "set_variable": { "name": "extend", "value": 1 } }],
            "to_after_key_up": [{ "set_variable": { "name": "extend", "value": 0 } }],
            "to_if_alone": [{ "key_code": "caps_lock" }],
            "type": "basic"
        },

        {
            "conditions": [{ "name": "extend", "type": "variable_if", "value": 1 }],
            "description": "Extend+⌘+Z → Undo at physical position (rescue — mandatory-modifier rules listed before catch-alls)",
            "from": { "key_code": "z", "modifiers": { "mandatory": ["left_command"], "optional": [] } },
            "to": [{ "key_code": "z", "modifiers": ["left_command"] }],
            "type": "basic"
        },
        {
            "conditions": [{ "name": "extend", "type": "variable_if", "value": 1 }],
            "description": "Extend+⌘+⇧+Z → Redo at physical position (rescue)",
            "from": { "key_code": "z", "modifiers": { "mandatory": ["left_command", "left_shift"], "optional": [] } },
            "to": [{ "key_code": "z", "modifiers": ["left_command", "left_shift"] }],
            "type": "basic"
        },
        {
            "conditions": [{ "name": "extend", "type": "variable_if", "value": 1 }],
            "description": "Extend+⌘+X → Cut at physical position (rescue)",
            "from": { "key_code": "x", "modifiers": { "mandatory": ["left_command"], "optional": [] } },
            "to": [{ "key_code": "x", "modifiers": ["left_command"] }],
            "type": "basic"
        },
        {
            "conditions": [{ "name": "extend", "type": "variable_if", "value": 1 }],
            "description": "Extend+⌘+C → Copy at physical position (rescue)",
            "from": { "key_code": "c", "modifiers": { "mandatory": ["left_command"], "optional": [] } },
            "to": [{ "key_code": "c", "modifiers": ["left_command"] }],
            "type": "basic"
        },
        {
            "conditions": [{ "name": "extend", "type": "variable_if", "value": 1 }],
            "description": "Extend+⌘+V → Paste at physical position (rescue)",
            "from": { "key_code": "v", "modifiers": { "mandatory": ["left_command"], "optional": [] } },
            "to": [{ "key_code": "v", "modifiers": ["left_command"] }],
            "type": "basic"
        },
        {
            "conditions": [{ "name": "extend", "type": "variable_if", "value": 1 }],
            "description": "Extend+⌘+F → Find at physical position (rescue)",
            "from": { "key_code": "f", "modifiers": { "mandatory": ["left_command"], "optional": [] } },
            "to": [{ "key_code": "f", "modifiers": ["left_command"] }],
            "type": "basic"
        },
        {
            "conditions": [{ "name": "extend", "type": "variable_if", "value": 1 }],
            "description": "Extend+⌘+S → Save at physical position (rescue)",
            "from": { "key_code": "s", "modifiers": { "mandatory": ["left_command"], "optional": [] } },
            "to": [{ "key_code": "s", "modifiers": ["left_command"] }],
            "type": "basic"
        },
        {
            "conditions": [{ "name": "extend", "type": "variable_if", "value": 1 }],
            "description": "Extend+⌘+N → New Document at physical position (rescue)",
            "from": { "key_code": "n", "modifiers": { "mandatory": ["left_command"], "optional": [] } },
            "to": [{ "key_code": "n", "modifiers": ["left_command"] }],
            "type": "basic"
        },
        {
            "conditions": [{ "name": "extend", "type": "variable_if", "value": 1 }],
            "description": "Extend+⌘+Q → Quit at physical position (rescue)",
            "from": { "key_code": "q", "modifiers": { "mandatory": ["left_command"], "optional": [] } },
            "to": [{ "key_code": "q", "modifiers": ["left_command"] }],
            "type": "basic"
        },
        {
            "conditions": [{ "name": "extend", "type": "variable_if", "value": 1 }],
            "description": "Extend+⌘+T → New Tab at physical position (rescue)",
            "from": { "key_code": "t", "modifiers": { "mandatory": ["left_command"], "optional": [] } },
