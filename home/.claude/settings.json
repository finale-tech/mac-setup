{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {},
  "defaultMode": "plan",
  "permissions": {
    "allow": [
      "Bash(./mvnw clean *)",
      "Bash(./mvnw test *)",
      "Bash(awk *)",
      "Bash(cat *)",
      "Bash(checkstyle *)",
      "Bash(curl *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(git -C * log *)",
      "Bash(git -C * status *)",
      "Bash(git -C * branch *)",
      "Bash(git -C * show *)",
      "Bash(git -C * diff *)",
      "Bash(git add * )",
      "Bash(git check-ignore * )",
      "Bash(git checkout * )",
      "Bash(git diff * )",
      "Bash(git fetch * )",
      "Bash(git log * )",
      "Bash(git ls-tree * )",
      "Bash(git pull * )",
      "Bash(git rebase * )",
      "Bash(git rm * )",
      "Bash(git stash * )",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls * )",
      "Bash(mkdir * )",
      "Bash(mvn clean * )",
      "Bash(mvn compile * )",
      "Bash(mvn jacoco:report * )",
      "Bash(mvn spring-boot:run * )",
      "Bash(mvn test * )",
      "Bash(mvn * )",
      "Bash(npx * )",
      "Bash(pmd check * )",
      "Bash(python3 * )",
      "Bash(rg *)",
      "Bash(sed * )",
      "Bash(sort * )",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(timeout 30 mvn spring-boot:run)",
      "Bash(tree * )",
      "Bash(type *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Edit(//tmp/**)",
      "Read",
      "WebFetch(domain:docs.anthropic.com)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(sudo *)",
      "Bash(sed -i *)",
      "Bash(sed -i* *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Read(~/.gnupg/**)",
      "Read(~/Library/Keychains/**)",
      "Read(//Library/Keychains/**)",
      "Read(//private/var/db/**)",
      "Read(//private/var/root/**)",
      "Read(//etc/master.passwd)"
    ],
    "ask": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/security-check.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/format-java.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notification.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py",
    "padding": 2
  },
  "outputStyle": "pedagogical",
  "effortLevel": "high",
  "voiceEnabled": true
}