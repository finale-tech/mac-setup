#!/bin/bash
# Git commit-msg hook to enforce conventional commit format
# This hook validates commit messages follow the pattern: type: description

# Get the commit message file
COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Define valid types
VALID_TYPES="feat|fix|refactor|test|docs|chore|style|perf|ci|build|revert"

# Color codes for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Skip validation for merge commits
if echo "$COMMIT_MSG" | grep -q "^Merge branch"; then
  exit 0
fi

# Skip validation for revert commits
if echo "$COMMIT_MSG" | grep -q "^Revert "; then
  exit 0
fi

# Validate format: type: description
# Must be between 10 and 72 characters (excluding whitespace)
# Must start with valid type followed by colon and space

# Check if message matches pattern
if ! echo "$COMMIT_MSG" | grep -qE "^($VALID_TYPES): .{1,}$"; then
  echo -e "${RED}❌ Invalid commit message format${NC}"
  echo ""
  echo "Commit message must follow conventional commits format:"
  echo -e "${YELLOW}  type: brief description${NC}"
  echo ""
  echo "Valid types:"
  echo "  feat     - New feature"
  echo "  fix      - Bug fix"
  echo "  refactor - Code refactoring"
  echo "  test     - Test changes"
  echo "  docs     - Documentation"
  echo "  chore    - Maintenance"
  echo "  style    - Code style/formatting"
  echo "  perf     - Performance improvement"
  echo "  ci       - CI/CD changes"
  echo "  build    - Build system changes"
  echo "  revert   - Revert previous commit"
  echo ""
  echo "Your message:"
  echo -e "${RED}  $COMMIT_MSG${NC}"
  echo ""
  echo "Examples of valid messages:"
  echo -e "${GREEN}  feat: add user authentication${NC}"
  echo -e "${GREEN}  fix: resolve null pointer in retry logic${NC}"
  echo -e "${GREEN}  refactor: extract validation into service${NC}"
  exit 1
fi

# Get first line (in case of multi-line commit)
FIRST_LINE=$(echo "$COMMIT_MSG" | head -n 1)

# Check length (should be <= 72 characters for good git log display)
MSG_LENGTH=${#FIRST_LINE}

if [ $MSG_LENGTH -gt 72 ]; then
  echo -e "${YELLOW}⚠️  Warning: Commit message is longer than 72 characters${NC}"
  echo "   Current length: $MSG_LENGTH characters"
  echo "   Message: $FIRST_LINE"
  echo ""
  echo "   For better git log readability, keep first line under 72 chars."
  echo "   Consider using additional lines for details."
  echo ""
  # Warning only - don't block the commit
fi

if [ $MSG_LENGTH -lt 10 ]; then
  echo -e "${RED}❌ Commit message too short${NC}"
  echo "   Current length: $MSG_LENGTH characters"
  echo "   Message: $FIRST_LINE"
  echo ""
  echo "   Commit messages should be descriptive (at least 10 characters)."
  exit 1
fi

# All validations passed
exit 0
